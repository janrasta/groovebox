+    static const uint8_t every[3] = {4, 2, 1};
+    uint32_t n = every[min(fxParam[FX_GLITCH][0], (uint8_t)2)];
+    uint32_t h = (s / n + fxSeed) * 2654435761u;
+    s = (h >> 8) % k.length + s % n;
+  }
+  int i = s % k.length;
+  return fxOn(FX_REVERSE) ? k.length - 1 - i : i;
